# Persistent SSH forwarding from the new storefront host to the PIM host.
# Install a dedicated key on the PIM host; do not put a password in this file.
SSH_HOST=10.10.1.76
SSH_PORT=22
SSH_USER=adm-quasar
SSH_KEY_PATH=/srv/inkar-shop/config/clickhouse-tunnel-ed25519
SSH_KNOWN_HOSTS_PATH=/srv/inkar-shop/config/clickhouse-known-hosts

# Local listener is bound only to Docker's host-gateway address. The Compose
# operation container reaches it as host.docker.internal:18123.
LOCAL_PORT=18123

# Address reachable from sshd on 10.10.1.76. Set this to the ClickHouse
# container IP or to a loopback-only published endpoint supplied by PIM ops.
REMOTE_CLICKHOUSE_HOST=replace_with_clickhouse_container_ip
REMOTE_CLICKHOUSE_PORT=8123
