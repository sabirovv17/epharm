# Generated secrets replace the __...__ tokens during `deploy.sh prepare`.
# Do not commit the generated /srv/inkar-shop/config/app.env.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NODE_OPTIONS=--max-old-space-size=768

DATABASE_URL=postgresql://inkar:__DATABASE_PASSWORD__@postgres:5432/inkar_cms
CATALOG_READ_SOURCE=postgres
MEDUSA_CACHE_DIR=/var/cache/inkar-shop/medusa

# Store API. Keep admin credentials in image-import.env, never here.
MEDUSA_URL=https://medusa.internal.example
MEDUSA_ALLOW_INSECURE_LEGACY_HTTP=false
MEDUSA_PUBLISHABLE_KEY=pk_replace_me
MEDUSA_SALES_CHANNEL=sc_replace_me
MEDUSA_REGION=reg_replace_me
MEDUSA_ENABLED=false
MEDUSA_READ_CONCURRENCY=3
MEDUSA_MAX_QUEUE=32
MEDUSA_QUEUE_TIMEOUT_MS=3000
MEDUSA_BREAKER_THRESHOLD=3
MEDUSA_BREAKER_COOLDOWN_MS=20000
MEDUSA_PROBE_TTL_MS=30000
MEDUSA_PROBE_TIMEOUT_MS=7500
MEDUSA_PROBE_STALE_SUCCESS_MS=120000

# Pharmacy prices and stock. The temporary HTTP endpoint is an SSH tunnel
# bound on the Docker host gateway; it is never published on 0.0.0.0.
CATALOG_OFFER_SOURCE=clickhouse
CLICKHOUSE_URL=http://host.docker.internal:18123
CLICKHOUSE_ALLOW_INSECURE_PRIVATE_HTTP=true
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=pharmacy_analytics
CLICKHOUSE_FACT_TABLE=pharmacy_analytics.fact_pharmacy_daily
CLICKHOUSE_MAP_TABLE=pharmacy_analytics.product_material_map

# Bounded incremental workers for a 4 CPU / 6 GB host.
CATALOG_OFFER_SYNC_LIMIT=300
CATALOG_OFFER_SYNC_CONCURRENCY=2
CATALOG_OFFER_SYNC_BATCH_SIZE=100
CATALOG_OFFER_SYNC_TIMEOUT_MS=10000
CATALOG_OFFER_SYNC_ATTEMPTS=2
CATALOG_OFFER_SYNC_BATCH_DELAY_MS=250
CATALOG_OFFER_SYNC_MAX_PHARMACIES=2500
CATALOG_OFFER_SYNC_MAX_RESPONSE_BYTES=8388608

# Demo customer journey: no SMS is sent or required.
CUSTOMER_AUTH_MODE=demo
SMS_PROVIDER=smsc
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_API_KEY=
SMSC_SENDER=
P1SMS_API_KEY=
P1SMS_CHANNEL=digit
P1SMS_SENDER=
CUSTOMER_AUTH_SECRET=__CUSTOMER_AUTH_SECRET__
CHECKOUT_QUOTE_SECRET=__CHECKOUT_QUOTE_SECRET__

ADMIN_TOKEN=__ADMIN_TOKEN__
CDP_HASH_SECRET=__CDP_HASH_SECRET__

# Durable ePharm order bridge. Keep disabled until backend migration, a verified
# pharmacy mapping and the exact UTC go-live timestamp are in place.
EPHARM_ORDER_SYNC_ENABLED=false
EPHARM_BASE_URL=https://epharm.inkar.kz
EPHARM_FULFILLMENT_SHARED_SECRET=
EPHARM_ORDER_START_AT=
EPHARM_SYNC_POLL_SEC=10
EPHARM_SYNC_TIMEOUT_MS=15000
EPHARM_SYNC_BATCH_SIZE=20
EPHARM_ALLOW_PRIVATE_HTTP=false

# Generated once by the first image build and then kept stable in this file.
VAPID_PUBLIC_KEY=__VAPID_PUBLIC_KEY__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE_KEY__
VAPID_SUBJECT=mailto:ops@inkar.kz

# Native iOS push. APNS_PRIVATE_KEY_BASE64 is base64 of the downloaded .p8;
# never commit the real values.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=kz.darihana.aptekaSoSklada
APNS_PRIVATE_KEY_BASE64=
APNS_PRODUCTION=true

# Public browser key. It is embedded at image build time, not a server secret.
NEXT_PUBLIC_YANDEX_MAPS_KEY=
