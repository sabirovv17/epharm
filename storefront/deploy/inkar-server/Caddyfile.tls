{
    admin off
    email ops@inkar.kz
}

{$SITE_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
    handle /stocks/api/v1/* {
        reverse_proxy https://10.10.1.81 {
            header_up Host inkeshopapteka.inkar.kz
            transport http {
                tls_server_name inkeshopapteka.inkar.kz
                dial_timeout 5s
                tls_timeout 5s
                response_header_timeout 65s
            }
        }
    }
    handle /stocks/* {
        respond "Not Found" 404
    }
    handle /stocks {
        respond "Not Found" 404
    }
    handle {
        reverse_proxy router:8080 {
            header_up X-Forwarded-Proto https
            transport http {
                dial_timeout 5s
                response_header_timeout 65s
            }
        }
    }
}
