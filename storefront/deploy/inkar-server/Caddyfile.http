{
    auto_https off
    admin off
}

http://{$SITE_DOMAIN}, http://{$SERVER_IP} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
    handle /stocks/api/v1/* {
        uri strip_prefix /stocks
        reverse_proxy epharm-stock-service:8080
    }
    handle /stocks/* {
        respond "Not Found" 404
    }
    handle {
        reverse_proxy router:8080 {
            header_up X-Forwarded-Proto http
            transport http {
                dial_timeout 5s
                response_header_timeout 65s
            }
        }
    }
}

# The public gateway terminates TLS and forwards CRM HTTP to this host.
http://crm.inkar.kz {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    reverse_proxy 10.10.1.80:8080 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto http
        transport http {
            dial_timeout 5s
            response_header_timeout 65s
        }
    }
}
