[Unit]
Description=Inkar storefront local liveness check
After=network.target inkar-shop.service
OnFailure=inkar-shop-health-recover.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=15s
# Only liveness drives automatic restarts. External Postgres/Medusa readiness
# is monitored separately with /api/health?deep=1 to avoid restart loops.
ExecStart=/usr/bin/curl --fail --silent --show-error --connect-timeout 2 --max-time 5 --retry 2 --retry-delay 1 --retry-connrefused --output /dev/null http://127.0.0.1:3000/api/health
