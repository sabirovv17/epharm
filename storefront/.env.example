# ───────── Публичный домен / reverse proxy ─────────
SITE_DOMAIN=apteka-demo.quasar-it.kz

# ───────── Medusa (товары/цены) — серверный read-path ─────────
MEDUSA_URL=https://medusa.example.kz
# Temporary compatibility switch for exactly http://78.140.246.238:9000.
# Keep false everywhere else and remove it after Medusa receives TLS.
MEDUSA_ALLOW_INSECURE_LEGACY_HTTP=false
MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEDUSA_SALES_CHANNEL=sc_xxxxxxxxxxxxxxxxxxxxxxxxxx
MEDUSA_REGION=reg_xxxxxxxxxxxxxxxxxxxxxxxxxx
MEDUSA_ENABLED=true
MEDUSA_READ_CONCURRENCY=3
MEDUSA_MAX_QUEUE=32
MEDUSA_QUEUE_TIMEOUT_MS=3000
MEDUSA_BREAKER_THRESHOLD=3
MEDUSA_BREAKER_COOLDOWN_MS=20000
MEDUSA_PROBE_TTL_MS=30000
MEDUSA_PROBE_TIMEOUT_MS=7500
MEDUSA_PROBE_STALE_SUCCESS_MS=120000

# После полного `npm run catalog:sync -- --apply` можно переключить чтение витрины
# на локальный Postgres. При ошибке сайт автоматически откатится на Medusa.
CATALOG_READ_SOURCE=medusa

# Incremental per-pharmacy price/availability warm-up. The public Medusa
# endpoint has no stock quantity field: presence in pharmacies[] is treated as
# in-stock by the current business contract; stock_quantity remains NULL.
CATALOG_OFFER_SYNC_LIMIT=300
CATALOG_OFFER_SYNC_CONCURRENCY=3
CATALOG_OFFER_SYNC_TIMEOUT_MS=10000
CATALOG_OFFER_SYNC_ATTEMPTS=2
CATALOG_OFFER_SYNC_BATCH_DELAY_MS=150
CATALOG_OFFER_SYNC_MAX_PHARMACIES=2500
CATALOG_OFFER_SYNC_MAX_RESPONSE_BYTES=8388608

# ───────── Яндекс Карты JS API 2.1 (карта аптек и выбор самовывоза) ─────────
# Клиентский ключ (NEXT_PUBLIC_ — уходит в браузер). В кабинете разработчика у ключа должен быть
# включён JavaScript API и разрешены домены витрины. Пусто → останется рабочий список аптек без карты.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# ───────── Админка ─────────
# Код входа в /admin И токен записи контента (/api/content, /api/upload).
# ОБЯЗАТЕЛЬНО задать длинным случайным значением. Без него админка не пускает (fail-closed).
ADMIN_TOKEN=

# ───────── P1SMS (SMS-коды подтверждения телефона) ─────────
# apiKey из admin.p1sms.kz (+ баланс на счету). Пусто → OTP недоступен; тестовый код не выдаётся.
P1SMS_API_KEY=
P1SMS_CHANNEL=digit
P1SMS_SENDER=
# P1SMS_SENDER=   # только если согласовано буквенное имя отправителя (channel != digit)

# ───────── Авторизация покупателя (реальный Medusa customer) ─────────
# sms (по умолчанию) = реальный OTP; demo = отдельный демо-покупатель без SMS.
CUSTOMER_AUTH_MODE=sms
# Секрет вывода пароля customer из номера телефона. ОБЯЗАТЕЛЬНО длинный случайный и СТАБИЛЬНЫЙ:
# при смене значения существующие пользователи не смогут войти (пароль выводится из номера).
# НЕ NEXT_PUBLIC (только сервер). На боевом сервере START.sh генерирует и хранит его в файле
# .customer-secret автоматически — задавать вручную не нужно.
CUSTOMER_AUTH_SECRET=
# Подпись серверной котировки checkout. Лучше отдельный стабильный секрет;
# при пустом значении код использует CUSTOMER_AUTH_SECRET как fallback.
CHECKOUT_QUOTE_SECRET=

# ───────── Общая БД (Postgres) ─────────
# Задан  → контент, заказы и Web Push хранятся в ОБЩЕЙ БД (боевой режим,
# переживает рестарты и несколько инстансов).
# Пусто  → локальные JSON-файлы в .data (только для разработки).
#
#  • Общая база Medusa:        postgresql://USER:PASS@HOST:5432/DBNAME
#  • Свой Postgres из compose: postgresql://inkar:CHANGE_ME@postgres:5432/inkar_cms
#  • Облачная (Neon/Supabase): postgresql://USER:PASS@HOST/DB?sslmode=require
POSTGRES_PASSWORD=please-generate-a-long-random-database-password
DATABASE_URL=postgresql://inkar:please-generate-a-long-random-database-password@postgres:5432/inkar_cms

# ───────── Web Push (статусы заказов и акции) ─────────
# Один раз сгенерировать: npx web-push generate-vapid-keys --json
# Ключи должны быть стабильными: при смене пары браузеры нужно подписывать заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@quasar-it.kz
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=kz.darihana.aptekaSoSklada
# Base64 of the downloaded .p8 file.
APNS_PRIVATE_KEY_BASE64=
APNS_PRODUCTION=true

# ───────── CDP: HMAC для обезличенных device/session ID ─────────
# Минимум 32 случайных символа; хранить только на сервере, не NEXT_PUBLIC.
CDP_HASH_SECRET=

# ePharm pharmacy-fulfillment bridge. Production requires a shared secret of at
# least 32 characters and an explicit UTC activation boundary.
EPHARM_ORDER_SYNC_ENABLED=false
EPHARM_BASE_URL=https://epharm.inkar.kz
EPHARM_FULFILLMENT_SHARED_SECRET=
EPHARM_ORDER_START_AT=
EPHARM_SYNC_POLL_SEC=10
EPHARM_SYNC_TIMEOUT_MS=15000
EPHARM_SYNC_BATCH_SIZE=20
EPHARM_ALLOW_PRIVATE_HTTP=false
