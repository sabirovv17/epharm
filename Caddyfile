# Reverse-proxy + TLS поверх прод-стека Epharm.
# Публичный wildcard-сертификат INKAR подключается из закрытого read-only mount.
{
	email {$ACME_EMAIL}
	# Public DNS terminates on the INKAR ingress, so ACME challenges cannot reach
	# this host. Certificate renewal is performed by INKAR IT and deployed manually.
	auto_https disable_certs
	servers {
		trusted_proxies static 10.10.1.74/32 10.10.1.80/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(unified_migration_write_freeze) {
	route {
		@frozen_nonposm {
			path /api/*
			method POST PUT PATCH DELETE
			not path /api/posm/*
			expression `"{$UNIFIED_MIGRATION_WRITE_FREEZE_ENABLED:false}" == "true"`
		}
		@frozen_staff {
			path /api/posm/staff /api/posm/staff/*
			method POST PUT PATCH DELETE
			expression `"{$UNIFIED_MIGRATION_WRITE_FREEZE_ENABLED:false}" == "true"`
		}
		handle @frozen_nonposm {
			header Cache-Control no-store
			header Retry-After 30
			header Content-Type application/json
			respond `{"code":"MIGRATION_WRITE_FREEZE","message":"Обновление системы. Повторите действие через минуту."}` 503
		}
		handle @frozen_staff {
			header Cache-Control no-store
			header Retry-After 30
			header Content-Type application/json
			respond `{"code":"MIGRATION_WRITE_FREEZE","message":"Обновление системы. Повторите действие через минуту."}` 503
		}
	}
}

(legacy_staff_entry) {
	@native_legacy_task {
		query task=*
		expression `"{$MERCH_LEGACY_PORTAL_CUTOVER_ENABLED:false}" == "true"`
	}
	handle @native_legacy_task {
		header Referrer-Policy no-referrer
		header Cache-Control no-store
		# Keep the browser URL until its synchronous bootstrap consumes and scrubs the capability.
		rewrite * /tasks/staff?
		reverse_proxy frontend:80 {
			header_up -X-Pharmapay-Key
			header_up -X-Staff-Session
		}
	}
	@native_staff_entry {
		expression `"{$MERCH_LEGACY_PORTAL_CUTOVER_ENABLED:false}" == "true"`
	}
	handle @native_staff_entry {
		header Referrer-Policy no-referrer
		header Cache-Control no-store
		# Retired code/plain entries stay native too: a CRM redirect would loop through the new edge.
		# The browser scrubs legacy access/claim fragments before telemetry.
		rewrite * /staff?
		reverse_proxy frontend:80 {
			header_up -X-Pharmapay-Key
			header_up -X-Staff-Session
		}
	}
	handle {
		header Referrer-Policy no-referrer
		header Cache-Control no-store
		redir https://crm.inkar.kz/staff{?query} 302
	}
}

# API/ADMIN/S3 используют один публичный хост (epharm.inkar.kz). Этот snippet
# обеспечивает единые маршруты для прямого Caddy TLS и внешнего TLS ingress.
(epharm_routes) {
	# Загрузки (фото чеков, слайды) идут через /api на backend — поднимаем лимит тела.
	request_body {
		max_size 64MB
	}

	# Публичный S3: фото чеков и слайды. App генерит ссылки как
	# https://<host>/s3/<bucket>/<key> (S3_PUBLIC_URL=.../s3). handle_path срезает
	# префикс /s3 → MinIO path-style видит /<bucket>/<key>.
	handle_path /s3/* {
		reverse_proxy minio:9000
	}

	# Архивы POSM не содержат секретов и могут кешироваться как статические файлы.
	# Доверие обеспечивается не общим fleet-key, а pinned ECDSA-подписью manifest и
	# SHA-256, которые клиент проверяет до установки. Приватный signing key сюда не попадает.
	handle_path /downloads/* {
		root * /srv/epharm-downloads
		file_server
	}

	# QR staff portal only. The merchandising admin/API remains private: unknown
	# paths and methods are denied before the /merch prefix is removed. The
	# server-to-server credential is never forwarded to a browser route.
	handle /merch/* {
		route {
			@portal_entry {
				path /merch/portal
				method GET HEAD
			}
			handle @portal_entry {
				header Referrer-Policy no-referrer
				header Cache-Control no-store
				reverse_proxy frontend:80 {
					header_up -X-Pharmapay-Key
					header_up -X-Staff-Session
				}
			}
			@retired_legacy_api {
				path /merch/api/public/task-dispatch /merch/api/public/task-dispatch/queue /merch/api/public/task-dispatch/start /merch/api/public/task-dispatch/checklist /merch/api/public/task-dispatch/evidence /merch/api/public/task-dispatch/submit /merch/api/task-files/* /merch/api/request-item-files/* /merch/api/placement-files/*
				expression `"{$MERCH_LEGACY_PORTAL_CUTOVER_ENABLED:false}" == "true"`
			}
			handle @retired_legacy_api {
				header Cache-Control no-store
				header Content-Type application/json
				respond `{"code":"MERCH_PORTAL_MOVED","message":"Повторно откройте QR-код: портал заданий обновлён. Неотправленные действия не подтверждены."}` 409
			}
			@merch_staff {
				path /merch/staff
				method GET
			}
			@merch_assets {
				path /merch/assets/* /merch/pharmacy-shelf.png
				method GET
			}
			@merch_task_api {
				path /merch/api/public/task-dispatch /merch/api/public/task-dispatch/queue /merch/api/public/task-dispatch/start /merch/api/public/task-dispatch/checklist /merch/api/public/task-dispatch/evidence /merch/api/public/task-dispatch/submit
				method POST
			}
			@merch_media {
				path /merch/api/task-files/* /merch/api/request-item-files/* /merch/api/placement-files/*
				method GET
			}
			handle @merch_staff {
				import legacy_staff_entry
			}
			handle @merch_assets {
				uri strip_prefix /merch
				reverse_proxy {$MERCH_PORTAL_UPSTREAM:10.10.1.80:8080} {
					header_up -X-Pharmapay-Key
				}
			}
			handle @merch_task_api {
				uri strip_prefix /merch
				reverse_proxy {$MERCH_PORTAL_UPSTREAM:10.10.1.80:8080} {
					header_up -X-Pharmapay-Key
				}
			}
			handle @merch_media {
				uri strip_prefix /merch
				reverse_proxy {$MERCH_PORTAL_UPSTREAM:10.10.1.80:8080} {
					header_up -X-Pharmapay-Key
				}
			}
			respond 404
		}
	}
	# The external CRM edge may forward only this task entry after its controlled cutover.
	handle /staff {
		@staff_get method GET
		handle @staff_get {
			import legacy_staff_entry
		}
		respond 404
	}

	# API для касс (/api/posm), телефонов (/api/mobile) и самой админки.
	handle /api/* {
		import unified_migration_write_freeze
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Всё остальное — веб-админка (SPA, статика из nginx фронта).
	handle {
		reverse_proxy frontend:80
	}
}

# Прямой доступ к серверу: Caddy завершает TLS сам.
{$ADMIN_DOMAIN} {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/private.key
	import epharm_routes
}

# Внешний ingress INKAR завершает wildcard TLS и проксирует epharm.inkar.kz
# обычным HTTP на 10.10.1.76:8060. Отдельный listener исключает redirect-loop.
http://{$ADMIN_DOMAIN}:8060 {
	# Direct origin traffic has no trusted HTTPS forwarding header. Redirect it
	# to the canonical public URL while allowing the INKAR TLS ingress through.
	@direct_http not header X-Forwarded-Proto https
	redir @direct_http https://{$ADMIN_DOMAIN}{uri} 308

	import epharm_routes
}

# ── Внутренний доступ к админке через корпоративный VPN / сеть INKAR ──────────
# inkpim.inkar.kz УЖЕ резолвится корп. DNS (10.10.1.119/120) в 10.10.1.76, а VPN
# маршрутизирует 10.10/16 → админ на VPN открывает админку БЕЗ публичного DNS.
# Plain HTTP: трафик уже в зашифрованном VPN-туннеле, а Let's Encrypt для непубличного
# имени не выдаётся. Отдаёт ту же админку (frontend nginx сам проксирует /api на backend).
# Имя переопределяется env INTERNAL_DOMAIN; пусто → блок не матчит запросы.
# NB: доступ ТОЛЬКО по имени. Прямой IP (http://10.10.1.76) тут НЕ работает: Caddy для
# bare-IP принудительно включает TLS (self-signed) и редиректит 80→443, где валидного
# сертификата под IP нет → тупик. Клиент обязан резолвить inkpim.inkar.kz: на корп.
# Windows это делает корп. DNS (10.10.1.119/120) сам; на macOS + Check Point VPN, где
# getaddrinfo не видит inkar.kz, нужна строка в /etc/hosts: «10.10.1.76 inkpim.inkar.kz».
http://{$INTERNAL_DOMAIN:inkpim.inkar.kz} {
	import unified_migration_write_freeze
	reverse_proxy frontend:80 {
		header_up X-Forwarded-For {client_ip}
	}
}
