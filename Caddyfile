# Reverse-proxy + автоматический TLS (Let's Encrypt) поверх прод-стека Epharm.
# Домены и email берутся из .env.prod (через environment контейнера caddy).
# Caddy сам получает и продлевает сертификаты; данные сертификатов — в volume caddy_data.

{
	email {$ACME_EMAIL}
}

# ВАЖНО: на этом этапе API/ADMIN/S3 — ОДИН публичный хост (sslip). Поэтому всё
# обслуживается ОДНИМ site-блоком с маршрутизацией по путям. Раздельные блоки на
# один и тот же адрес → Caddy: «ambiguous site definition» и крах (инцидент 22.06.2026).
# Если позже домены РАЗВЕДУТ на разные хосты (api./admin./s3.epharm.kz) — верни
# три отдельных блока по {$API_DOMAIN}/{$ADMIN_DOMAIN}/{$S3_DOMAIN}.
{$ADMIN_DOMAIN} {
	# Загрузки (фото чеков, слайды) идут через /api на backend — поднимаем лимит тела.
	request_body {
		max_size 64MB
	}

	# Публичный S3: фото чеков и слайды. App генерит ссылки как
	# https://<host>/s3/<bucket>/<key> (S3_PUBLIC_URL=.../s3). handle_path срезает
	# префикс /s3 → MinIO path-style видит /<bucket>/<key>.
	handle_path /s3/* {
		reverse_proxy minio:9000
	}

	# API для касс (/api/posm), телефонов (/api/mobile) и самой админки.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Всё остальное — веб-админка (SPA, статика из nginx фронта).
	handle {
		reverse_proxy frontend:80
	}
}

# ── Внутренний доступ к админке через корпоративный VPN / сеть INKAR ──────────
# inkpim.inkar.kz УЖЕ резолвится корп. DNS (10.10.1.119/120) в 10.10.1.76, а VPN
# маршрутизирует 10.10/16 → админ на VPN открывает админку БЕЗ публичного DNS.
# Plain HTTP: трафик уже в зашифрованном VPN-туннеле, а Let's Encrypt для непубличного
# имени не выдаётся. Отдаёт ту же админку (frontend nginx сам проксирует /api на backend).
# Имя переопределяется env INTERNAL_DOMAIN; пусто → блок не матчит запросы.
# NB: доступ ТОЛЬКО по имени. Прямой IP (http://10.10.1.76) тут НЕ работает: Caddy для
# bare-IP принудительно включает TLS (self-signed) и редиректит 80→443, где валидного
# сертификата под IP нет → тупик. Клиент обязан резолвить inkpim.inkar.kz: на корп.
# Windows это делает корп. DNS (10.10.1.119/120) сам; на macOS + Check Point VPN, где
# getaddrinfo не видит inkar.kz, нужна строка в /etc/hosts: «10.10.1.76 inkpim.inkar.kz».
http://{$INTERNAL_DOMAIN:inkpim.inkar.kz} {
	reverse_proxy frontend:80
}
