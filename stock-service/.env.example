STOCK_API_KEY=replace-with-random-read-api-token
STOCK_REFRESH_SECONDS=180
STOCK_COLLECTION_ENABLED=false

# Dedicated PostgreSQL instance, separate from HQ/CMS databases.
STOCK_PG_ADMIN_PASSWORD=replace-with-random-superuser-password
STOCK_PG_OWNER_PASSWORD=replace-with-random-schema-owner-password
STOCK_PG_PASSWORD=replace-with-random-app-password
STOCK_PG_DATA_DIR=/srv/epharm-stock-postgres/data

# Existing SQLite image is mounted read-only for one-time historical import.
STOCK_HOST_DATA_DIR=/home/adm-quasar/stock-service/data
