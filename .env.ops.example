# Copy to /etc/epharm/backup.env on the production host (owner root, mode 600).
EPHARM_DEPLOY_DIR=/home/adm-quasar/epharm
EPHARM_ENV_FILE=/home/adm-quasar/epharm/.env.prod
BACKUP_ROOT=/var/backups/epharm
BACKUP_RETENTION_DAYS=30
MINIO_BACKUP_BUCKETS=epharm-receipts
BACKUP_REQUIRE_OFFSITE=true

# Encrypted off-site restic repository. Examples: s3:https://s3.example/bucket,
# sftp:user@backup-host:/srv/epharm. Store RESTIC_PASSWORD only in this mode-600 file.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
RESTIC_CHECK_SUBSET=1/20

# Keep these pinned to tested images. Upgrade only together with a restore-test.
POSTGRES_RESTORE_IMAGE=postgres:16-alpine
MINIO_RESTORE_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
