+/* Backend-bound operational refinement · 2026-11-03 */
+.ops-tasks-page.task-workspace {
+  max-width: 1600px;
+  margin: 0 auto;
+  padding: 22px;
+  background: #f3f7f6;
+}
+.ops-tasks-page.task-workspace .ops-tasks-heading {
+  align-items: flex-end;
+  margin-bottom: 16px;
+}
+.ops-tasks-page.task-workspace .ops-tasks-heading h1 {
+  margin: 0 0 5px;
+  color: #172020;
+  font-size: clamp(26px, 2vw, 32px);
+  line-height: 1.12;
+  letter-spacing: -.025em;
+}
+.ops-tasks-page.task-workspace .ops-tasks-heading p {
+  margin: 0;
+  color: #667270;
+  font-size: 14px;
+}
+.ops-tasks-page.task-workspace button {
+  box-shadow: none;
+}
+.ops-tasks-page.task-workspace button:hover {
+  transform: none;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics {
+  gap: 6px;
+  margin-bottom: 10px;
+  padding: 0;
+  border: 1px solid #d9e2e0;
+  border-radius: 9px;
+  overflow: hidden;
+  background: #fff;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button {
+  min-height: 48px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0 12px;
+  border: 0;
+  border-right: 1px solid #d9e2e0;
+  border-radius: 0;
+  background: #fff;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button:last-child {
+  border-right: 0;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button > span {
+  display: none;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button small {
+  order: 1;
+  color: #465452;
+  font-size: 11px;
+  font-weight: 700;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button strong {
+  order: 2;
+  margin-left: auto;
+  color: #172020;
+  font-size: 16px;
+}
+.ops-tasks-page.task-workspace .ops-task-metrics button.active {
+  color: #075158;
+  background: #eef9f7;
+  box-shadow: inset 0 -3px #0b776f;
+}
+.ops-tasks-page.task-workspace .task-workspace-filters {
+  margin-bottom: 10px;
+  padding: 10px;
+  border: 1px solid #d9e2e0;
+  border-radius: 9px;
+  background: #fff;
+  box-shadow: none;
+}
+.ops-tasks-page.task-workspace .task-workspace-results {
+  min-height: 42px;
+  margin-bottom: 0;
+  padding: 0 4px;
+}
+.ops-tasks-page.task-workspace .ops-dispatch-list {
+  gap: 0;
+  border: 1px solid #d9e2e0;
+  border-radius: 9px;
+  overflow: hidden;
+  background: #fff;
