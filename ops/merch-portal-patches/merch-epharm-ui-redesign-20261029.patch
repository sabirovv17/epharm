@@ -0,0 +1,559 @@
+/*
+ * Merchandising workspace v3.
+ * Intentionally scoped to staff tasks and the public QR flow so the customer,
+ * advertiser and platform shells keep their existing behaviour and layout.
+ */
+
+.task-workspace,
+.ops-task-create-drawer,
+.task-workspace-viewer,
+.public-task-page,
+.public-task-shell {
+  --merch-teal-950: #073f46;
+  --merch-teal-800: #075f5d;
+  --merch-teal-700: #087b77;
+  --merch-teal-600: #0d918a;
+  --merch-teal-100: #dcf4f0;
+  --merch-teal-50: #effaf8;
+  --merch-ink: #173438;
+  --merch-muted: #607174;
+  --merch-line: #d8e4e2;
+  --merch-canvas: #f4f7f7;
+  --merch-danger: #c7473d;
+  --merch-warning: #a96912;
+  --merch-shadow: 0 16px 42px rgba(7, 63, 70, .09);
+}
+
+/* Desktop command centre */
+.ops-tasks-page.task-workspace {
+  max-width: none;
+  padding: 30px clamp(18px, 3vw, 46px) 64px;
+  background:
+    radial-gradient(circle at 92% 0, rgba(13, 145, 138, .08), transparent 28rem),
+    var(--merch-canvas);
+  color: var(--merch-ink);
+}
+
+.task-workspace .ops-tasks-heading {
+  max-width: 1560px;
+  margin: 0 auto 18px;
+  padding: 0 2px;
+}
+
+.ops-tasks-page.task-workspace .ops-tasks-heading h1 {
+  margin: 2px 0 5px;
+  color: var(--merch-ink);
+  font-size: clamp(30px, 3vw, 40px);
+  letter-spacing: -.035em;
+}
+
+.ops-tasks-page.task-workspace .ops-tasks-heading p {
+  max-width: 760px;
+  color: var(--merch-muted);
+  font-size: 13px;
+}
+
+.task-workspace .eyebrow { color: var(--merch-teal-700); }
+.task-workspace .ops-task-heading-actions > .primary,
