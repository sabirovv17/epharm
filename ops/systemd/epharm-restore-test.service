[Unit]
Description=Epharm isolated backup restore test
Requires=docker.service
After=docker.service epharm-backup.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/epharm/backup.env
ExecStart=/usr/bin/env bash -lc 'cd "$EPHARM_DEPLOY_DIR" && exec ./tools/restore-test.sh'
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
