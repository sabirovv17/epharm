[Unit]
Description=Epharm PostgreSQL and MinIO backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/epharm/backup.env
ExecStart=/usr/bin/env bash -lc 'cd "$EPHARM_DEPLOY_DIR" && exec ./tools/backup-all.sh'
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
