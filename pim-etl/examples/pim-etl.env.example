# Install as /etc/pim-dashboard/pim-etl.env with mode 0600.
# Replace every example value before enabling either timer.
CLICKHOUSE_CONTAINER=pim-clickhouse
CLICKHOUSE_DB=pharmacy_analytics
CLICKHOUSE_USER=replace-with-etl-user
CLICKHOUSE_PASSWORD=replace-with-a-long-random-secret

PIM_ROOT=/var/lib/pim-dashboard
PIM_ARTIFACT_ROOT=/var/lib/pim-dashboard/validated
PIM_STAGING_ROOT=/var/lib/pim-dashboard/staging
PIM_REJECTS_ROOT=/var/lib/pim-dashboard/rejects
PIM_SMB_CREDENTIALS_FILE=/etc/pim-dashboard/smb-credentials
PIM_MAX_SOURCE_BYTES=68719476736
PIM_BACKUP_RETENTION_HOURS=72

# Independent allowlist for the forced-command snapshot receiver.
# Do not set this to the retired commerce origin merely because the IP matches an old deployment.
PIM_MEDUSA_ALLOWED_HOST=receiver.example.invalid
PIM_MEDUSA_ALLOWED_USER=standardn-ingest
PIM_MEDUSA_ALLOWED_PORT=22
PIM_MEDUSA_CONFIG=/etc/pim-dashboard/medusa-push.json
