<Window x:Class="CustomerDisplay.RecommendationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epharm"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="392"
        MaxHeight="700">

    <Window.Resources>
        <DataTemplate x:Key="OfferRowTemplate">
            <Border Background="#FAF8F5" BorderBrush="#E8E2DA" BorderThickness="1"
                    CornerRadius="9" Padding="10" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                            Background="#EFE4DE" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Number}" Foreground="#8B432D" FontSize="10.5"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="7,0,10,0">
                        <TextBlock Text="{Binding Name}" Foreground="#211D19" FontSize="13.5"
                                   FontWeight="Bold" TextWrapping="Wrap" LineHeight="17"/>
                        <TextBlock Text="{Binding Meta}" Foreground="#766E65" FontSize="10.5"
                                   FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding TriggerContext}" Foreground="#9A4427" FontSize="10.5"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#615950" FontSize="10.5"
                                   TextWrapping="Wrap" MaxHeight="30" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding PartnerLabel}" Foreground="#8B432D" FontSize="9.5"
                                   FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Price}" Foreground="#211D19" FontSize="12.5"
                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Bonus}" Foreground="#A24C30" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="13" Background="White" Margin="12"
            BorderBrush="#D8D1C7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="22" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#8B432D" CornerRadius="6" Width="22" Height="22"
                        VerticalAlignment="Center">
                    <TextBlock Text="i" Foreground="White" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <TextBlock Text="Рекомендации" Foreground="#211D19" FontWeight="Bold" FontSize="15"/>
                    <TextBlock x:Name="TbHeaderCount" Foreground="#847B72" FontSize="10.5"
                               FontWeight="SemiBold" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="26" Height="26" FontSize="12"
                        Foreground="#6F665B" Background="#F1EEE9" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#E8E2DA"/>

            <ScrollViewer Grid.Row="2" MaxHeight="552" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalFirst"
                          CanContentScroll="True" Padding="0,0,3,0">
                <StackPanel Margin="14,10,11,5">
                    <StackPanel x:Name="PanelSubstitutions" Margin="0,0,0,9">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЗАМЕНА" Foreground="#8B432D" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#EFE4DE" CornerRadius="8" Padding="7,2">
                                <TextBlock x:Name="TbSubstitutionCount" Foreground="#8B432D"
                                           FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <Border x:Name="SubstitutionTrigger" Background="#F4F1EC" CornerRadius="8"
                                Padding="9,7" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="ПОКУПАТЕЛЬ ПОПРОСИЛ" Foreground="#91877E"
                                           FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TbSubstitutionTrigger" Foreground="#302A25"
                                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ПРЕДЛОЖИТЕ ВМЕСТО" Foreground="#91877E" FontSize="9.5"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="SubstitutionList" ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelCrossSells">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ДОПРОДАЖА" Foreground="#42604F" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E6EFE9" CornerRadius="8" Padding="7,2">
                                <TextBlock x:Name="TbCrossSellCount" Foreground="#42604F"
                                           FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <Border x:Name="CrossSellTrigger" Background="#F4F1EC" CornerRadius="8"
                                Padding="9,7" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="УЖЕ В ЧЕКЕ" Foreground="#91877E"
                                           FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TbCrossSellTrigger" Foreground="#302A25"
                                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ДОБАВЬТЕ К ПОКУПКЕ" Foreground="#91877E" FontSize="9.5"
                                   FontWeight="Bold" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="CrossSellList" ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="#E8E2DA" BorderThickness="0,1,0,0"
                    Padding="14,8" Background="#FCFBF9" CornerRadius="0,0,13,13">
                <TextBlock Text="Колесо мыши — прокрутить список" Foreground="#91877E"
                           FontSize="9.5" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
