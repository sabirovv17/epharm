<Window x:Class="CustomerDisplay.RecommendationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекомендации Epharm"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="500"
        MaxHeight="900">

    <Window.Resources>
        <!-- Colour follows the bonus on this offer, never the rule or the other offers. -->
        <DataTemplate x:Key="OfferRowTemplate">
            <Border x:Name="OfferCard" BorderThickness="1" CornerRadius="10" Padding="11,10"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="164"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="RankCircle" Grid.Column="0" Width="38" Height="38"
                            CornerRadius="19" VerticalAlignment="Top">
                        <TextBlock x:Name="RankText" Text="{Binding Number}"
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock x:Name="NameText" Text="{Binding Name}"
                                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                   LineHeight="21"/>
                        <TextBlock x:Name="MetaText" Text="{Binding Meta}"
                                   FontSize="15" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TriggerText" Text="{Binding TriggerContext}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock x:Name="PriceText" Text="{Binding Price}"
                                   FontSize="23" FontWeight="Bold" HorizontalAlignment="Right"
                                   TextAlignment="Right" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BonusText" Text="{Binding Bonus}"
                                   FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   TextAlignment="Right" TextWrapping="NoWrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="DetailText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="21" Margin="4,5,0,0">
                        <Run x:Name="DetailPrefix" Text="{Binding DetailLabel}" FontWeight="Bold"/>
                        <Run Text="{Binding Detail}"/>
                    </TextBlock>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasBonus}" Value="False">
                    <Setter TargetName="OfferCard" Property="Background" Value="White"/>
                    <Setter TargetName="OfferCard" Property="BorderBrush" Value="#D7DCE4"/>
                    <Setter TargetName="RankCircle" Property="Background" Value="#EEF0F2"/>
                    <Setter TargetName="RankText" Property="Foreground" Value="#111627"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="#171A2F"/>
                    <Setter TargetName="MetaText" Property="Foreground" Value="#677083"/>
                    <Setter TargetName="TriggerText" Property="Foreground" Value="#677083"/>
                    <Setter TargetName="PriceText" Property="Foreground" Value="#171A2F"/>
                    <Setter TargetName="BonusText" Property="Foreground" Value="#596274"/>
                    <Setter TargetName="DetailText" Property="Foreground" Value="#20263A"/>
                    <Setter TargetName="DetailPrefix" Property="Foreground" Value="#9F1329"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBonus}" Value="True">
                    <Setter TargetName="OfferCard" Property="Background" Value="#087B39"/>
                    <Setter TargetName="OfferCard" Property="BorderBrush" Value="#056E32"/>
                    <Setter TargetName="RankCircle" Property="Background" Value="#32975F"/>
                    <Setter TargetName="RankText" Property="Foreground" Value="White"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                    <Setter TargetName="MetaText" Property="Foreground" Value="#D6EFE0"/>
                    <Setter TargetName="TriggerText" Property="Foreground" Value="#D6EFE0"/>
                    <Setter TargetName="PriceText" Property="Foreground" Value="White"/>
                    <Setter TargetName="BonusText" Property="Foreground" Value="#D7EFAD"/>
                    <Setter TargetName="DetailText" Property="Foreground" Value="#F5FFF8"/>
                    <Setter TargetName="DetailPrefix" Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetail}" Value="False">
                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Meta}" Value="">
                    <Setter TargetName="MetaText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TriggerContext}" Value="">
                    <Setter TargetName="TriggerText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="17" Background="White" Margin="12"
            BorderBrush="#D7DCE4" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#141B2A" Opacity="0.25" BlurRadius="34" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,12,14,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Рекомендации" Foreground="#171A2F"
                           FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" Width="42" Height="42" FontSize="28"
                        FontWeight="Light" Foreground="#171B2E" Background="#F0F1F3"
                        BorderThickness="0" Cursor="Hand" Click="OnCloseClick"
                        ToolTip="Закрыть рекомендации"/>
            </Grid>

            <Border x:Name="TopTriggerContext" Grid.Row="1" Background="#F1F2F4"
                    CornerRadius="10" Margin="15,0,15,8" Padding="13,9">
                <StackPanel>
                    <TextBlock x:Name="TbTopTriggerLabel" Text="ПОКУПАТЕЛЬ ПОПРОСИЛ"
                               Foreground="#70788A" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TbTopTrigger" Foreground="#171A2F" FontSize="16"
                               FontWeight="Bold" TextWrapping="Wrap" LineHeight="19"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" MaxHeight="700" MinHeight="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalFirst" CanContentScroll="True"
                          Padding="0,0,3,0">
                <StackPanel Margin="15,0,12,5">
                    <StackPanel x:Name="PanelSubstitutions" Margin="0,0,0,12">
                        <TextBlock x:Name="TbSubstitutionCount" Foreground="#9F1329"
                                   FontSize="22" FontWeight="Bold" Margin="0,0,0,7"/>
                        <ItemsControl x:Name="SubstitutionList"
                                      ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelCrossSells">
                        <TextBlock x:Name="TbCrossSellCount" Foreground="#9F1329"
                                   FontSize="22" FontWeight="Bold" Margin="0,0,0,7"/>
                        <Border x:Name="CrossSellTrigger" Background="#F1F2F4"
                                CornerRadius="9" Padding="9,7" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="УЖЕ В ЧЕКЕ" Foreground="#70788A"
                                           FontSize="11.5" FontWeight="Bold"/>
                                <TextBlock x:Name="TbCrossSellTrigger" Foreground="#171A2F"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="CrossSellList"
                                      ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="#E3E6EB" BorderThickness="0,1,0,0"
                    Padding="15,9" Background="White" CornerRadius="0,0,17,17">
                <TextBlock Text="Колесо мыши — прокрутить список" Foreground="#5D6576"
                           FontSize="12.5"/>
            </Border>
        </Grid>
    </Border>
</Window>
