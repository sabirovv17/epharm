<Window x:Class="CustomerDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Customer Display"
WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black">
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Видео (75%) -->
        <Border Grid.Column="0" Background="Black">
            <vlc:VideoView x:Name="VideoView" Background="Black"/>
        </Border>

        
        <!-- Чек (25%) -->
        <Border Grid.Column="1" Background="White" Padding="0">
            <DockPanel LastChildFill="True">

                <!-- Низ: итог (зафиксирован) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,5,0,10" Background="#DDDDDD"/>

    <Grid Margin="20,0,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ИТОГО:" Foreground="Black" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" x:Name="TbTotal" Foreground="Black" FontSize="30" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <!-- Верх + список: общий scope для одинаковых ширин колонок -->
  <!-- Таблица чеков -->
<StackPanel>

    <!-- Заголовки -->
   
        <StackPanel>

            <!-- Название -->
            <TextBlock Text="Название"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="Black"/>

            <!-- Нижняя строка заголовков -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Цена"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Right"/>

                <TextBlock Grid.Column="1"
                           Text="Кол-во"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Right"/>

                <TextBlock Grid.Column="2"
                           Text="Скидка"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Right"/>

                <TextBlock Grid.Column="3"
                           Text="Сумма"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Right"/>
            </Grid>
<Separator Margin="0,6,0,6"/>

        </StackPanel>


    <!-- Позиции -->
    <ListView x:Name="ItemsList"
              Background="Transparent"
              BorderThickness="0"
              Foreground="Black"
              HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="False"
              ClipToBounds="True">

        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
            <DataTemplate>
                
                    <StackPanel>

                        <!-- Название позиции -->
                        <TextBlock Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   LineHeight="17"/>

                        <!-- Цифры -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding PriceText}"
                                       FontSize="13"
                                       TextAlignment="Right"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Qty, StringFormat={}{0:0.00}}"
                                       FontSize="13"
                                       TextAlignment="Right"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DiscountPercent, StringFormat={}{0:0}%}"
                                       FontSize="13"
                                       TextAlignment="Right"/>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding TotalText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextAlignment="Right"/>

                        </Grid>
<Separator Margin="0,6,0,6"/>
                    </StackPanel>
            
            </DataTemplate>
        </ListView.ItemTemplate>

    </ListView>

</StackPanel>


            </DockPanel>
        </Border>
  
    </Grid>
</Window>
