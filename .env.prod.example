# Шаблон секретов/настроек прод-стека Epharm.
# Скопировать в .env.prod (НЕ коммитится) и заполнить реальными значениями:
#   cp .env.prod.example .env.prod && nano .env.prod
# Запуск:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=epharm
POSTGRES_USER=epharm
POSTGRES_PASSWORD=                 # ОБЯЗАТЕЛЬНО: длинный случайный пароль

# ── MinIO / S3 (фото чеков, слайды) ──────────────────────────────────────────
MINIO_ROOT_USER=epharm
MINIO_ROOT_PASSWORD=               # ОБЯЗАТЕЛЬНО: длинный случайный пароль
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Публичный адрес S3, по которому браузер/приложение грузят фото. НЕ http://minio:9000
# (это только внутри docker-сети). Укажи внешний IP/домен сервера, напр.:
#   http://<SERVER_IP>:9000   или   https://s3.epharm.kz (за reverse-proxy)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# ── Backend секреты ──────────────────────────────────────────────────────────
# JWT_SECRET: МИНИМУМ 256 бит (32+ симв). Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Ключ устройства касс (X-Posm-Key). Сгенерировать: openssl rand -hex 24
POSM_DEVICE_KEY=
# Origins админки через запятую, без trailing slash. Напр. https://admin.epharm.kz
CORS_ALLOWED_ORIGINS=http://localhost:8088
# OTP: false = реальный случайный код + SMS (прод). true = фиксированный 544544 (только dev!).
OTP_DEV_MODE=false

# ── Порты наружу ─────────────────────────────────────────────────────────────
BACKEND_PORT=8080                  # кассы/телефоны бьют сюда (за TLS-прокси в проде)
ADMIN_PORT=8088                    # веб-админка
