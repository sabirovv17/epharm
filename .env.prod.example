# Шаблон секретов/настроек прод-стека Epharm.
# Скопировать в .env.prod (НЕ коммитится) и заполнить реальными значениями:
#   cp .env.prod.example .env.prod && nano .env.prod
# Запуск:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ── Домены + TLS (Caddy + Let's Encrypt) ─────────────────────────────────────
# epharm.inkar.kz — единый публичный домен: /api/* и /s3/* маршрутизируются Caddy.
API_DOMAIN=epharm.inkar.kz      # кассы (/api/posm) и телефоны (/api/mobile)
ADMIN_DOMAIN=epharm.inkar.kz    # веб-админка
S3_DOMAIN=epharm.inkar.kz       # публичные фото чеков/слайды через /s3/*
ACME_EMAIL=admin@inkar.kz       # email для Let's Encrypt (уведомления о сертификатах)
# Закрытая директория с fullchain.pem и private.key для wildcard *.inkar.kz.
# Не коммитить. На сервере: root:root, каталог 700, private.key 600.
TLS_CERT_DIR=./tls

# ── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=epharm
POSTGRES_USER=epharm
POSTGRES_PASSWORD=                 # ОБЯЗАТЕЛЬНО: длинный случайный пароль

# ── MinIO / S3 (фото чеков, слайды) ──────────────────────────────────────────
MINIO_ROOT_USER=epharm
MINIO_ROOT_PASSWORD=               # ОБЯЗАТЕЛЬНО: длинный случайный пароль
MINIO_CONSOLE_PORT=9001            # консоль администрирования (закрыть файрволом/VPN)
# Внутренний адрес для backend SDK (PUT/DELETE) — внутри docker-сети, не менять.
S3_ENDPOINT=http://minio:9000
# Внешний адрес для ссылок в браузере — через Caddy по https и /s3.
S3_PUBLIC_URL=https://epharm.inkar.kz/s3
S3_REGION=us-east-1

# ── Backend секреты ──────────────────────────────────────────────────────────
# JWT_SECRET: МИНИМУМ 256 бит (32+ симв). Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Ключ устройства касс (X-Posm-Key). Сгенерировать: openssl rand -hex 24
POSM_DEVICE_KEY=
# Origins админки через запятую, без trailing slash.
CORS_ALLOWED_ORIGINS=https://epharm.inkar.kz
# OTP: false = реальный внешний SMS-код (прод). true = фиксированный 544544 (только dev!).
OTP_DEV_MODE=false
# Полный внешний OTP-цикл Daribar из swag.json: /api/v2/sms + /api/v2/auth.
OTP_PROVIDER=daribar
DARIBAR_OTP_BASE_URL=https://prod-backoffice.daribar.com
DARIBAR_OTP_TIMEOUT_MS=10000
# SMS-провайдер p1sms.kz (admin.p1sms.kz). API-ключ — в ЛК: «Эмулятор запросов»/«Инструкция по API».
# Используется только при OTP_PROVIDER=p1sms. Канал: digit | char (нужен P1SMS_SENDER).
P1SMS_API_KEY=
P1SMS_CHANNEL=digit
P1SMS_SENDER=
# Bootstrap первого admin-аккаунта HQ-консоли. БЕЗ них в админку не войти (admin_users пуста).
# Создаётся один раз при первом старте, если таблица пуста (роль HQ_HEAD). Пароль — надёжный.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=HQ Admin
ADMIN_BOOTSTRAP_COMPANY=Inkar

# ── Medusa-витрина inkar.kz (Module 3) — реальный каталог для мобилки ─────────
# Бэкенд ходит сюда server-to-server и проксирует товары в /api/mobile/catalog/*.
# publishable-ключ/канал/регион — клиентские идентификаторы (по дизайну Medusa они
# публикуемые, как в любом storefront), держать здесь безопасно. РЕАЛЬНЫЕ секреты
# витрины (SSH root, admin-пароли из STOREFRONT-CREDENTIALS.md) сюда НЕ кладём и в
# репозиторий не коммитим — их нужно ротировать (см. claude-admin-notes.md).
MEDUSA_ENABLED=true
# Когда витрина получит TLS — поменять на https://api.inkar.kz.
MEDUSA_BASE_URL=http://78.140.246.238:9000
MEDUSA_PUBLISHABLE_KEY=pk_ed9c35a59066b45de7d9e12510468ca27af16b6d0170b0910c03746545da4525
MEDUSA_SALES_CHANNEL_ID=sc_01KRXGQFYXMJN3FD1WJ7S83WME
MEDUSA_REGION_ID=reg_01KSBNEH2D4GVJN8EATK79WNSH
# Публичный HTTPS-origin ePharm (без завершающего slash), используется в QR сертификатов.
APP_PUBLIC_BASE_URL=https://epharm.inkar.kz
